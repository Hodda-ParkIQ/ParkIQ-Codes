# Default: real provider data. Never place API keys in frontend/VITE variables.
DATA_MODE=live
REPOSITORY=memory
DATABASE_URL=postgresql://parkiq:parkiq@localhost:5432/parkiq
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173","http://localhost:8000","http://127.0.0.1:8000","https://appassets.androidplatform.net"]
SEOUL_API_KEY=
SEOUL_BASE_URL=http://openapi.seoul.go.kr:8088
PRIVATE_API_URL=
PRIVATE_API_KEY=
ROUTING_API_URL=
ROUTING_API_KEY=
# Self-hosted Valhalla (compose profile "routing"): http://valhalla:8002, local run: http://localhost:8002
VALHALLA_URL=
ADMIN_API_KEY=
SYNC_ENABLED=true
SYNC_INTERVAL_SECONDS=300
STALE_AFTER_SECONDS=600
# Backend-only hosting: false = do not serve the built frontend at / (API only).
# With docker compose also set APP_TARGET=api to skip the frontend build entirely.
SERVE_FRONTEND=true
APP_TARGET=full
# Comma-separated extra CORS origins, e.g. the separately hosted frontend URL.
CORS_EXTRA_ORIGINS=
